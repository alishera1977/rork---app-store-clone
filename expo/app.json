{
  "expo": {
    "name": "Промметпласт",
    "slug": "prommetplast",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prommetplast",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prommetplast.mobile",
      "infoPlist": {
        "CFBundleDisplayName": "Промметпласт",
        "CFBundleName": "Промметпласт",
        "NSCameraUsageDescription": "Камера нужна, чтобы сфотографировать металлолом для предварительной оценки.",
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен, чтобы выбрать изображение металлолома для предварительной оценки.",
        "NSUserNotificationsUsageDescription": "Уведомления используются, чтобы сообщать об изменении цен на металл, статусе ваших заявок на вывоз и важных новостях компании."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "ru.prommetplast.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d0ca44ab-ce15-445a-8e5c-f4fc52adbcb1"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}